#!/bin/sh
# TheRock ROCm driver wrapper generated by the llm-orch rocm overlay.
# Sets ROCm env, injects NixOS host-target flags exactly once per driver
# chain (hipcc resolves clang++ through PATH), then execs the real binary.
export HIP_PATH="${HIP_PATH:-@TREE@}"
export CUDA_PATH="${CUDA_PATH:-@TREE@}"
export LLVM_HOME="${LLVM_HOME:-@TREE@/llvm}"
if [ -z "${ROCM_HOST_FLAGS_DONE-}" ]; then
  export ROCM_HOST_FLAGS_DONE=1
  exec @REAL@ @INCLUDES@ @LIBS@ "$@"
fi
exec @REAL@ "$@"
